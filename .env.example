# ---------------------------------------------------------------------------
# Crochet Studio — environment template
# Copy to `.env.local` and fill in real values. `.env*` is git-ignored.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# Development uses SQLite so you can start with zero setup.
# The schema is written to be provider-portable, so switching to Postgres later
# only requires changing `provider` in prisma/schema.prisma and this URL.
DATABASE_URL="file:./dev.db"

# Switching to Postgres (recommended before you deploy) looks like:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crochet_studio?schema=public"

# Auth -----------------------------------------------------------------------
# Generate a real secret with:  openssl rand -base64 32
# (or run:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" )
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Set to the public origin once you deploy.
AUTH_URL="http://localhost:3000"

# AI (Phase 10 — not used yet, kept here so you never put it in client code) ---
# OPENAI_API_KEY=""
